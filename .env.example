# RouteShield Environment Configuration Template
# OpenRouteService (ORS) API Key for real-time routing & geocoding
# Get your free API key at: https://openrouteservice.org/dev/#/signup
VITE_ORS_API_KEY=your_openrouteservice_api_key_here

# Note: If VITE_ORS_API_KEY is not provided, RouteShield automatically activates
# its high-fidelity built-in Pune road routing engine so you can test all features offline.
